# 数据库
REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_URL=mysql+pymysql://your-username:your-password@127.0.0.1:3306/nginx_insight?charset=utf8mb4

# 百度地图
# 使用开通“普通 IP 定位”的服务端 AK；需匹配服务器出口 IP 白名单。
BAIDU_MAP_AK=
# 单个 geo 进程的请求速率，允许小数：0.5 表示每两秒一次；缓存命中不计入。
GEO_QPS=1
# 收到 401/402 或 HTTP 429 后的初始、最大冷却时间（秒），连续限流会指数延长。
GEO_COOLDOWN_SECONDS=60
GEO_MAX_COOLDOWN_SECONDS=900

# Nginx
# 活动日志扫描间隔（秒），允许小数。
POLL_INTERVAL=1
# 日志时间按原文入库，不进行时区转换；应用与 Nginx 应使用相同的服务器本地时间。
NGINX_LOG_DIR=/var/log/nginx
# 逗号或空白分隔的 IP/CIDR，例如 127.0.0.1,::1,192.168.1.0/24。
# 命中后跳过日志及新定位任务入库，但推进采集偏移；不删除已有数据。
NGINX_IP_WHITELIST=

# 服务日志
LOG_LEVEL=INFO
# 留空仅输出到 stderr；相对路径以进程工作目录为准，父目录须存在且可写。
# 文件按 10 MiB 轮转，保留 5 份历史日志。
LOG_FILE=./nginx_insight.log

# Web 路径前缀
# 空值表示根路径部署；生产环境可设为 /nginx-insight，代理须保留此前缀。
# 修改后重启 Web 服务；仅支持由字母、数字、下划线和连字符组成的路径段。
URL_PREFIX=

# 登录认证
# 账号、密码、SESSION_SECRET 均配置后才启用管理登录；公开统计不受影响。
DASHBOARD_USER=
DASHBOARD_PASSWORD=
# HTTPS 部署设为 true；本地 HTTP 调试保持 false，否则浏览器不会发送会话 Cookie。
SESSION_COOKIE_SECURE=false
# 独立随机密钥，所有 Web worker 使用同一值；更换后重启全部 worker，旧会话失效。
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
